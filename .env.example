# Spring API and public AI API origin (production: HTTPS)
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_API_BASE_URL=http://localhost:8000
# Current server supports first-frame auth. Use query only for an older deployment.
VITE_VOICE_AUTH_MODE=frame

# Optional local voice metrics forwarding to the Vite terminal (development only)
VITE_VOICE_DIAGNOSTICS_FORWARD=false
